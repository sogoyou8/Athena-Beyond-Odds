# =============================================================================
# ABYSS / Athena — Variables d'environnement locales (Modèle d'exemple)
# =============================================================================
#
# Ce fichier est un modèle public de configuration locale. Il ne contient aucun secret.
#
# REGLES DE SECURITE ABSOLUES :
#   1. Copier ce fichier en .env.local  ->  cp .env.example .env.local
#   2. Renseigner vos clés réelles UNIQUEMENT dans .env.local
#   3. Utiliser uniquement .env.local pour les clés locales de ce protocole.
#   4. NE JAMAIS committer de fichier .env.local (vérifier son exclusion par Git)
#   5. NE JAMAIS faire figurer de clés API réelles dans les logs ou les rapports
#   6. En cas d'exposition accidentelle d'une clé API, la révoquer IMMEDIATEMENT
#
# Le fichier .env.local est protégé contre le tracking Git via .gitignore.
# =============================================================================

# --- football-data.org ---
# Clé d'API obtenue sur https://www.football-data.org/client/register
# Mettre la clé d'API réelle dans .env.local
FOOTBALL_DATA_API_KEY=

# --- Sportmonks ---
# Clé d'API obtenue sur https://my.sportmonks.com/ (après activation de l'essai)
# Mettre la clé d'API réelle dans .env.local
SPORTMONKS_API_KEY=

# --- Environnement ---
# Valeur : development | test | production
NODE_ENV=development

# --- Fournisseur de données sportives ---
# Valeur : footballdataorg | mock
# Référence : sports-data-provider-contract.md §4
SPORTS_DATA_PROVIDER=mock

# --- Persistance locale ---
# Valeur : sqlite | memory
# Référence : sqlite-persistence-design.md §3.C
PERSISTENCE_MODE=sqlite

# --- Cache mémoire local ---
# Valeur : true | false
# Référence : in-memory-cache-design.md §4
CACHE_ENABLED=true

# --- Port HTTP ---
PORT=3000
